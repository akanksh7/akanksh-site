---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import fuel from '../../data/fuel.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('logs',(e:any)=>!e.data.draft)).sort((x:any,y:any)=>+y.data.date-+x.data.date);
const top = posts.slice(0,3), rest = posts.slice(3);
const fills:any[] = [...fuel.fills].sort((a:any,c:any)=>a.date.localeCompare(c.date));
const sum=(a:any[],k:string)=>a.reduce((s:number,r:any)=>s+r[k],0);
const wavg=(a:any[])=>{const d=sum(a,'distance');return d?a.reduce((s:number,r:any)=>s+r.distance*r.mileage,0)/d:null};
const avg = wavg(fills) ?? 0, tracked = sum(fills,'distance');
const odo = fills.length?Math.max(...fills.map(r=>r.odometer)):0;
const others:any[] = (fuel as any).other_costs || [], otherSum = sum(others,'cost'), fuelSpent = sum(fills,'cost'), litres = sum(fills,'litres');
const inr=(n:number)=>`₹${Math.round(n).toLocaleString('en-IN')}`;
// Monthly distance: the distance since the previous fill is spread evenly over the days between the two fills.
const D=864e5, dist:Record<string,number>={};
for(let i=1;i<fills.length;i++){const a=+new Date(fills[i-1].date),c=+new Date(fills[i].date),days=Math.round((c-a)/D);if(days<=0)continue;const per=fills[i].distance/days;for(let k=0;k<days;k++){const m=new Date(a+k*D).toISOString().slice(0,7);dist[m]=(dist[m]||0)+per}}
const keys=[...new Set([...fills.map(r=>r.date.slice(0,7)),...Object.keys(dist)])].sort();
const months=keys.map(m=>{const r=fills.filter(x=>x.date.startsWith(m));return {m,km:dist[m]||0,spent:sum(r,'cost'),litres:sum(r,'litres'),kmpl:wavg(r)}});
const W=640,H=210,P=36; const T=fills.map(r=>+new Date(r.date)); const t0=Math.min(...T),t1=Math.max(...T);
const X=(d:string)=>P+((+new Date(d)-t0)/((t1-t0)||1))*(W-2*P);
const lo=Math.floor(Math.min(...fills.map(r=>r.mileage))*0.9), hi=Math.max(...fills.map(r=>r.mileage))*1.1;
const Ym=(v:number)=>H-P-((v-lo)/((hi-lo)||1))*(H-2*P);
const line=fills.map(r=>`${X(r.date)},${Ym(r.mileage)}`).join(' ');
const stats:any[]=[['Odometer',`${odo.toLocaleString('en-IN')} km`],['Distance tracked',`${tracked.toLocaleString('en-IN')} km`],['Total spent',inr(fuelSpent+otherSum),`Fuel ${inr(fuelSpent)}\nOther costs ${inr(otherSum)}`],['Other costs',inr(otherSum),others.length?others.map((o:any)=>`${o.item}: ${inr(o.cost)}`).join('\n'):'No other costs recorded'],['Fuel bought',`${litres.toFixed(1)} L`],['Avg petrol price',`₹${(fuelSpent/litres).toFixed(1)}/L`],['Average mileage',`${avg.toFixed(1)} km/l`]];
const info=(r:any)=>[r.date,r.bunk||'Bunk not recorded',r.fuel||'Petrol type not recorded'];
---
<Base title="Motorcycle"><div style="padding:56px 0 0"><h1>Motorcycle</h1><p class="sub">Weekly notes on what I learn, plus a fuel and mileage tracker.</p>
<svg viewBox="0 0 640 8" width="100%" height="8" aria-hidden="true"><line class="road" x1="0" y1="4" x2="640" y2="4" stroke="var(--acc)" stroke-width="2"/></svg></div>
<h2>Weekly notes</h2>
{top.map((e:any)=><a class="row" href={`${b}/motorcycle/${e.id}/`}><span class="meta">{e.data.date.toISOString().slice(0,10)}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p></a>)}
{rest.length>0 && <details class="expand"><summary>Show {rest.length} more note{rest.length===1?'':'s'}</summary>{rest.map((e:any)=><a class="row" href={`${b}/motorcycle/${e.id}/`}><span class="meta">{e.data.date.toISOString().slice(0,10)}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p></a>)}</details>}
{!posts.length && <p class="sub">No notes yet.</p>}
<h2>Fuel and mileage</h2>
{fuel.sample && <p class="meta">Sample data. Replace the entries in src/data/fuel.json (or use the editor's Fuel log).</p>}
{fills.length<2 ? <p>Add at least two fill-ups to see mileage.</p> : <>
<div class="stats">{stats.map(([l,v,t],n)=><div class={'stat'+(t?' pt':'')} tabindex={t?0:undefined} data-tip={t} style={`--i:${n}`}><span class="meta">{l}</span><b>{v}</b></div>)}</div>
<p class="meta">Hover or tap Total spent or Other costs for the breakdown.</p>
<p class="meta">Mileage per fill-up (km/l). Hover or tap a point to see the bunk and petrol type.</p>
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart of mileage in km per litre over time" style="width:100%;height:auto"><line x1={P} y1={H-P} x2={W-P} y2={H-P} stroke="var(--line)"/><polyline points={line} fill="none" stroke="var(--acc)" stroke-width="2"/>
{fills.map(r=><><circle class="pt" tabindex="0" data-tip={[...info(r),`${r.mileage} km/l over ${r.distance} km`,`${inr(r.cost)} for ${r.litres} L (₹${(r.cost/r.litres).toFixed(1)}/L)`].join('\n')} cx={X(r.date)} cy={Ym(r.mileage)} r="6" fill="var(--acc)"/><text x={X(r.date)} y={Ym(r.mileage)-11} font-size="11" text-anchor="middle" fill="var(--mut)">{r.mileage}</text></>)}
<text x={P} y={H-10} font-size="11" fill="var(--mut)">{fills[0].date}</text><text x={W-P} y={H-10} font-size="11" text-anchor="end" fill="var(--mut)">{fills[fills.length-1].date}</text></svg>
<h3>By month</h3><div style="overflow-x:auto"><table><thead><tr><th>Month</th><th>Distance</th><th>Fuel spent</th><th>Litres</th><th>km/l</th></tr></thead><tbody>{months.map(m=><tr><td>{m.m}</td><td>{Math.round(m.km)} km</td><td>{inr(m.spent)}</td><td>{m.litres.toFixed(1)}</td><td>{m.kmpl?m.kmpl.toFixed(1):'–'}</td></tr>)}</tbody></table></div>
<p class="meta">Mileage is the figure you enter for each fill-up, averaged by distance. Monthly distance is estimated by spreading each fill-up's distance over the days since the previous fill, so the first month may be partial.</p></>}
<style is:global>.tip{position:absolute;background:var(--fg);color:var(--bg);font:13px/1.4 var(--sans);padding:8px 12px;border-radius:6px;white-space:pre-line;z-index:20;pointer-events:none;max-width:260px}.pt{cursor:pointer;outline:none}.pt:hover,.pt:focus{stroke:var(--fg);stroke-width:2}.stat.pt:focus-visible{outline:2px solid var(--acc)}details.expand summary{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:8px 18px;cursor:pointer;font:15px var(--sans);list-style:none;margin:16px 0}details.expand summary:hover{border-color:var(--acc);color:var(--acc)}details.expand[open] summary{margin-bottom:0}</style>
<script is:inline>var tip=document.createElement('div');tip.className='tip';tip.hidden=true;document.body.appendChild(tip);
function show(e){var t=e.currentTarget;tip.textContent=t.dataset.tip;tip.hidden=false;var r=t.getBoundingClientRect();tip.style.left=Math.max(8,Math.min(innerWidth-tip.offsetWidth-8,r.left+r.width/2-tip.offsetWidth/2))+'px';tip.style.top=(scrollY+r.top-tip.offsetHeight-10)+'px'}
document.querySelectorAll('.pt').forEach(function(n){['mouseenter','focus','click'].forEach(function(v){n.addEventListener(v,show)});['mouseleave','blur'].forEach(function(v){n.addEventListener(v,function(){tip.hidden=true})})})</script></Base>
