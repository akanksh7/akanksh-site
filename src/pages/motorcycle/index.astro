---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import fuel from '../../data/fuel.json';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('logs',(e:any)=>!e.data.draft)).sort((x:any,y:any)=>+y.data.date-+x.data.date);
const top = posts.slice(0,3), rest = posts.slice(3);
const fills:any[] = [...fuel.fills].sort((a,c)=>a.date.localeCompare(c.date));
const rows = fills.map((f,i)=>{const km=i?f.odometer-fills[i-1].odometer:0;return {...f,km,kmpl:i&&f.litres?km/f.litres:null}});
const w = rows.filter(r=>r.kmpl!=null);
const sum=(a:any[],k:string)=>a.reduce((s,r)=>s+r[k],0);
const avg = w.length?sum(w,'km')/sum(w,'litres'):0;
const odo = rows.length?Math.max(...rows.map(r=>r.odometer)):0, tracked = rows.length?odo-rows[0].odometer:0;
// Spread the km between two fills evenly over the days between them, then total per month.
const D=864e5, dist:Record<string,number>={};
for(let i=1;i<fills.length;i++){const a=+new Date(fills[i-1].date),c=+new Date(fills[i].date),days=Math.round((c-a)/D);if(days<=0)continue;const per=(fills[i].odometer-fills[i-1].odometer)/days;for(let k=0;k<days;k++){const m=new Date(a+k*D).toISOString().slice(0,7);dist[m]=(dist[m]||0)+per}}
const keys=[...new Set([...rows.map(r=>r.date.slice(0,7)),...Object.keys(dist)])].sort();
const months=keys.map(m=>{const r=rows.filter(x=>x.date.startsWith(m)),q=r.filter(x=>x.kmpl!=null);return {m,km:dist[m]||0,spent:sum(r,'cost'),litres:sum(r,'litres'),kmpl:q.length?sum(q,'km')/sum(q,'litres'):null}});
const W=640,H=210,P=36; const T=rows.map(r=>+new Date(r.date)); const t0=Math.min(...T),t1=Math.max(...T);
const X=(d:string)=>P+((+new Date(d)-t0)/((t1-t0)||1))*(W-2*P);
const mk=(vals:number[],lo:number)=>{const hi=Math.max(...vals)*1.1;return (v:number)=>H-P-((v-lo)/((hi-lo)||1))*(H-2*P)};
const Yc=mk(rows.map(r=>r.cost),0);
const lo=w.length?Math.floor(Math.min(...w.map(r=>r.kmpl))*0.9):0, Ym=mk(w.map(r=>r.kmpl),lo);
const line=w.map(r=>`${X(r.date)},${Ym(r.kmpl)}`).join(' ');
const info=(r:any)=>[r.date,r.bunk||'Bunk not recorded',r.fuel||'Petrol type not recorded'];
const rowEl=(e:any)=>e;
---
<Base title="Motorcycle"><div style="padding:56px 0 0"><h1>Motorcycle</h1><p class="sub">Weekly notes on what I learn, plus a fuel and mileage tracker.</p>
<svg viewBox="0 0 640 8" width="100%" height="8" aria-hidden="true"><line class="road" x1="0" y1="4" x2="640" y2="4" stroke="var(--acc)" stroke-width="2"/></svg></div>
<h2>Weekly notes</h2>
{top.map((e:any)=><a class="row" href={`${b}/motorcycle/${e.id}/`}><span class="meta">{e.data.date.toISOString().slice(0,10)}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p></a>)}
{rest.length>0 && <details class="expand"><summary>Show {rest.length} more note{rest.length===1?'':'s'}</summary>{rest.map((e:any)=><a class="row" href={`${b}/motorcycle/${e.id}/`}><span class="meta">{e.data.date.toISOString().slice(0,10)}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p></a>)}</details>}
{!posts.length && <p class="sub">No notes yet.</p>}
<h2>Fuel and mileage</h2>
{fuel.sample && <p class="meta">Sample data. Replace the entries in src/data/fuel.json (or use the editor's Fuel log).</p>}
{rows.length<2 ? <p>Add at least two fill-ups to see mileage.</p> : <>
<div class="stats">{[['Odometer',`${odo.toLocaleString('en-IN')} km`],['Distance tracked',`${tracked.toLocaleString('en-IN')} km`],['Total spent',`₹${Math.round(sum(rows,'cost')).toLocaleString('en-IN')}`],['Fuel bought',`${sum(rows,'litres').toFixed(1)} L`],['Average mileage',`${avg.toFixed(1)} km/l`]].map(([l,v],n)=><div class="stat" style={`--i:${n}`}><span class="meta">{l}</span><b>{v}</b></div>)}</div>
<p class="meta">Amount paid per fill-up (₹). Hover or tap a bar for details.</p>
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Bar chart of the amount paid at each fill-up over time" style="width:100%;height:auto"><line x1={P} y1={H-P} x2={W-P} y2={H-P} stroke="var(--line)"/>
{rows.map(r=><><rect class="pt" tabindex="0" data-tip={[...info(r),`₹${Math.round(r.cost)} for ${r.litres} L`].join('\n')} x={X(r.date)-8} y={Yc(r.cost)} width="16" height={H-P-Yc(r.cost)} fill="var(--acc)" rx="2"/><text x={X(r.date)} y={Yc(r.cost)-5} font-size="11" text-anchor="middle" fill="var(--mut)">{Math.round(r.cost)}</text></>)}
<text x={P} y={H-10} font-size="11" fill="var(--mut)">{rows[0].date}</text><text x={W-P} y={H-10} font-size="11" text-anchor="end" fill="var(--mut)">{rows[rows.length-1].date}</text></svg>
<p class="meta">Mileage per fill-up (km/l). Hover or tap a point to see the bunk and petrol type.</p>
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Line chart of mileage in km per litre over time" style="width:100%;height:auto"><line x1={P} y1={H-P} x2={W-P} y2={H-P} stroke="var(--line)"/><polyline points={line} fill="none" stroke="var(--acc)" stroke-width="2"/>
{w.map(r=><><circle class="pt" tabindex="0" data-tip={[...info(r),`${r.kmpl.toFixed(1)} km/l over ${r.km} km`].join('\n')} cx={X(r.date)} cy={Ym(r.kmpl)} r="6" fill="var(--acc)"/><text x={X(r.date)} y={Ym(r.kmpl)-11} font-size="11" text-anchor="middle" fill="var(--mut)">{r.kmpl.toFixed(1)}</text></>)}
<text x={P} y={H-10} font-size="11" fill="var(--mut)">{rows[0].date}</text><text x={W-P} y={H-10} font-size="11" text-anchor="end" fill="var(--mut)">{rows[rows.length-1].date}</text></svg>
<h3>By month</h3><div style="overflow-x:auto"><table><thead><tr><th>Month</th><th>Distance</th><th>Spent</th><th>Litres</th><th>km/l</th></tr></thead><tbody>{months.map(m=><tr><td>{m.m}</td><td>{Math.round(m.km)} km</td><td>₹{Math.round(m.spent)}</td><td>{m.litres.toFixed(1)}</td><td>{m.kmpl?m.kmpl.toFixed(1):'–'}</td></tr>)}</tbody></table></div>
<p class="meta">Monthly distance is estimated: the km between two fill-ups are spread evenly over the days between them, so the first and last month may be partial. Mileage assumes a full tank each time.</p></>}
<style is:global>.tip{position:absolute;background:var(--fg);color:var(--bg);font:13px/1.4 var(--sans);padding:8px 12px;border-radius:6px;white-space:pre-line;z-index:20;pointer-events:none;max-width:260px}.pt{cursor:pointer;outline:none}.pt:hover,.pt:focus{stroke:var(--fg);stroke-width:2}details.expand summary{display:inline-block;border:1px solid var(--line);border-radius:99px;padding:8px 18px;cursor:pointer;font:15px var(--sans);list-style:none;margin:16px 0}details.expand summary:hover{border-color:var(--acc);color:var(--acc)}details.expand[open] summary{margin-bottom:0}</style>
<script is:inline>var tip=document.createElement('div');tip.className='tip';tip.hidden=true;document.body.appendChild(tip);
function show(e){var t=e.currentTarget;tip.textContent=t.dataset.tip;tip.hidden=false;var r=t.getBoundingClientRect();tip.style.left=Math.max(8,Math.min(innerWidth-tip.offsetWidth-8,r.left+r.width/2-tip.offsetWidth/2))+'px';tip.style.top=(scrollY+r.top-tip.offsetHeight-10)+'px'}
document.querySelectorAll('.pt').forEach(function(n){['mouseenter','focus','click'].forEach(function(v){n.addEventListener(v,show)});['mouseleave','blur'].forEach(function(v){n.addEventListener(v,function(){tip.hidden=true})})})</script></Base>
