---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { sections, colOf } from '../../config';
export async function getStaticPaths(){
  const out:any[]=[];
  for (const section of Object.keys(sections)) {
    const col = colOf[section] ?? section;
    const all:any[] = (await getCollection(col as any,(e:any)=>!e.data.draft)).sort((x:any,y:any)=>+y.data.date-+x.data.date);
    all.forEach((e,i)=>{
      const related = all.filter(o=>o.id!==e.id && o.data.tags.some((t:string)=>e.data.tags.includes(t))).slice(0,3).map(o=>({id:o.id,title:o.data.title}));
      const pick=(o:any)=>o&&{id:o.id,title:o.data.title};
      out.push({params:{section,slug:e.id},props:{e,section,related,newer:pick(all[i-1]),older:pick(all[i+1])}});
    });
  }
  return out;}
const { e, section, related, newer, older } = Astro.props; const { Content, headings } = await render(e);
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const mins = Math.max(1, Math.round((e.body ?? '').split(/\s+/).length/230));
const h2 = headings.filter((h:any)=>h.depth===2);
const labels:any={author:'Author',status:'Status',rating:'Rating (1-5)',result:'Result',activity:'Activity',odometer:'Odometer (km)',fuel_litres:'Fuel (L)',fuel_cost:'Fuel cost (INR)',tech:'Technologies',repo:'Repository',demo:'Live demo'};
const facts = Object.entries(labels).filter(([k])=>e.data[k]!=null&&!(Array.isArray(e.data[k])&&!e.data[k].length)).map(([k,l]:any)=>[l,Array.isArray(e.data[k])?e.data[k].join(', '):String(e.data[k])]);
const type = sections[section as keyof typeof sections];
---
<Base title={e.data.title} description={e.data.summary}>
<article class="prose" data-pagefind-body style="padding:56px 0"><span hidden data-pagefind-filter="type">{type}</span>{e.data.tags.map((t:string)=><span hidden data-pagefind-filter="tag">{t}</span>)}
<p class="meta">{e.data.date.toISOString().slice(0,10)} · {mins} min read</p>
<h1 data-pagefind-meta="title">{e.data.title}</h1><p class="sub">{e.data.summary}</p>
{h2.length>2 && <nav aria-label="Contents" class="meta" style="display:block">{h2.map((h:any)=><div><a href={`#${h.slug}`}>{h.text}</a></div>)}</nav>}
{facts.length>0 && <dl class="meta" style="border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:12px 0;margin:24px 0">{facts.map(([l,v]:any)=><div><dt style="display:inline">{l}: </dt><dd style="display:inline;margin:0">{v}</dd></div>)}</dl>}<Content/></article>
<aside class="prose" data-pagefind-ignore>
{related.length>0 && <><p class="meta">Related</p>{related.map((r:any)=><a class="row" href={`${b}/${section}/${r.id}/`}>{r.title}</a>)}</>}
<p class="meta" style="display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:16px">
{older?<a href={`${b}/${section}/${older.id}/`}>← {older.title}</a>:<span/>}{newer?<a href={`${b}/${section}/${newer.id}/`}>{newer.title} →</a>:<span/>}</p></aside></Base>
