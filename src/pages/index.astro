---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { site, icons } from '../config';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const pub = async (c:any)=> (await getCollection(c,(e:any)=>!e.data.draft)).sort((x:any,y:any)=>+y.data.date-+x.data.date);
const [w,p] = [await pub('writing'),await pub('projects')];
const feat = p.find((x:any)=>x.data.featured) ?? p[0];
const tiles = [['writing','Blogs','Articles and essays'],['projects','Projects','Things I have built'],['reading','Reading','Books and notes'],['motorcycle','Motorcycle','Weekly learnings and a fuel tracker'],['photos','Photos','A visual journal'],['timeline','Timeline','Milestones in order']];
---
<Base title={site.name}>
<section class="hero" style="padding:72px 0 40px"><div class="rule"></div><h1>Things I've built. Things I've learned. <span class="grad">Things I don't want to forget.</span></h1>
<p class="sub">A personal archive of software, ideas, experiments, and lessons.</p></section>
<div class="tiles">{tiles.map(([k,t,d],n)=><a class="tile" style={`--i:${n}`} href={`${b}/${k}/`}><svg class="ti" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[k]}></svg><h3>{t}</h3><p>{d}</p></a>)}</div>
{feat && <section><p class="meta">Featured project</p><a class="feat row" style="display:block" href={`${b}/projects/${feat.id}/`}><h3 style="font-size:2rem">{feat.data.title}</h3><p>{feat.data.summary}</p></a></section>}
<section><p class="meta">Latest blogs</p>{w.slice(0,4).map((e:any)=><a class="row" href={`${b}/writing/${e.id}/`}><span class="meta">{e.data.date.toISOString().slice(0,10)} · {e.data.category}</span><h3>{e.data.title}</h3><p>{e.data.summary}</p></a>)}</section>
</Base>
